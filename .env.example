# Copy to .env / export in your shell. Never commit real keys.

# OpenAI-compatible chat completions endpoint (GPT-OSS-120B-PIPELINE, LLM-FLOWCHART-PIPELINE)
LLM_BASE_URL=http://localhost:8000/v1/chat/completions
LLM_MODEL=gptoss120
LLM_API_KEY=your-key-here

# Ollama-style /api/chat endpoint (nlp_keyword_pipeline LLM extractor)
LLM_CHAT_URL=http://localhost:11434/api/chat
